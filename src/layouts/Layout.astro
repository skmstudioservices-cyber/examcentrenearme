---
const { title = 'Exam Centre Near Me' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content="Find exam centres across India — search by state, city or PIN code." />
  <link rel="canonical" href={Astro.url.href.split('?')[0]} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <style>
    :root{--ac:#2563EB;--bg:#f8fafc;--card:#fff;--tx:#12203a;--mu:#64748b;--ln:#e2e8f0}
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:ui-sans-serif,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;color:var(--tx);background:var(--bg);line-height:1.6}
    .wrap{max-width:1000px;margin:0 auto;padding:0 18px}
    header{background:#0f172a;color:#fff;padding:14px 0}
    header .wrap{display:flex;align-items:center;gap:10px}
    .logo{width:38px;height:38px;border-radius:10px;background:var(--ac);display:grid;place-items:center;font-weight:800}
    a{color:var(--ac)}
    .hero{background:#0f172a;color:#fff;padding:26px 0 20px}
    .hero h1{font-size:clamp(1.4rem,3.4vw,2rem)}
    .hero p{color:#cbd5e1;margin-top:8px;max-width:640px;font-size:.95rem}
    .filters{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}
    .f{padding:8px 14px;border-radius:99px;border:1px solid #334155;background:#1e293b;color:#cbd5e1;font-size:.82rem;font-weight:700;text-decoration:none}
    .f:hover{background:var(--ac);color:#fff;border-color:var(--ac)}
    .stats{display:flex;gap:18px;flex-wrap:wrap;margin:16px 0;font-size:.85rem;color:var(--mu)}
    .stats b{color:var(--tx);font-size:1.1rem}
    .card{background:var(--card);border:1px solid var(--ln);border-radius:14px;padding:18px 20px;margin:14px 0}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px;margin-top:10px}
    .cell{display:block;background:var(--card);border:1px solid var(--ln);border-radius:10px;padding:10px 12px;text-decoration:none;color:var(--tx);font-weight:600;font-size:.9rem}
    .cell:hover{border-color:var(--ac);color:var(--ac)}
    .cc{font-size:.75rem;color:var(--mu);display:block;font-weight:500}
    footer{margin-top:30px;padding:18px 0;border-top:1px solid var(--ln);color:var(--mu);font-size:.78rem;text-align:center}
  </style>
</head>
<body>
<header><div class="wrap"><div class="logo">E</div><div><b>Exam Centre Near Me</b></div></div></header>
<slot />
<footer>Exam Centre Near Me — sample build · data is illustrative until verified · © OpenStreetMap contributors where maps are used</footer>
</body>
</html>
